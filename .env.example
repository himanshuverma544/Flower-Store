# FloraLux Floral Studio — Environment Configuration Template
# Copy this file to .env and provide your local/staging credentials.
# NEVER commit production credentials or actual API secrets.

# ==============================================================================
# Database Configuration (Neon PostgreSQL)
# ==============================================================================
DATABASE_URL="postgresql://user:password@host/database?sslmode=verify-full"
DATABASE_URL_POOLED="postgresql://user:password@host-pooler/database?sslmode=verify-full"

# ==============================================================================
# Payload CMS
# ==============================================================================
PAYLOAD_SECRET="replace-with-a-secure-random-32-byte-hex-string"

# Cloudflare R2 / S3 Object Storage (Media uploads)
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="your-bucket-name"
R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
R2_PUBLIC_URL="https://your-public-cdn.example.com"

# ==============================================================================
# Razorpay Payment Gateway
# ==============================================================================
# Razorpay API Credentials (from Razorpay Dashboard -> Settings -> API Keys)
# Keep in Test Mode (starts with rzp_test_) during development.
RAZORPAY_KEY_ID="rzp_test_yourKeyId"
RAZORPAY_KEY_SECRET="yourRazorpayKeySecret"

# Razorpay Webhook Secret (from Razorpay Dashboard -> Settings -> Webhooks)
# IMPORTANT:
# 1. This is a DEDICATED secret generated specifically when adding a webhook endpoint.
# 2. Never use RAZORPAY_KEY_SECRET as a substitute for RAZORPAY_WEBHOOK_SECRET.
# 3. Webhook Endpoint URL in Dashboard: https://<your-domain>/api/webhooks/razorpay
# 4. Required Webhook Events to enable:
#    - payment.captured
#    - order.paid
#    - payment.failed
RAZORPAY_WEBHOOK_SECRET="yourRazorpayWebhookSecret"
