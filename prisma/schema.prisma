generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_POOLED")
  directUrl = env("DATABASE_URL")
}

model Order {
  id               String   @id
  date             String
  total            Float
  status           String
  currentStep      Int      @default(1)
  estimatedDelivery String  @default("Tomorrow")
  slot             String   @default("Morning (9 AM - 1 PM)")

  // Recipient
  recipientName    String
  recipientAddress String
  recipientPhone   String
  recipientApt     String   @default("")
  recipientCity    String   @default("")
  recipientState   String   @default("")
  recipientZip     String   @default("")
  recipientNotes   String   @default("")

  // Sender
  senderName       String
  senderEmail      String
  senderPhone      String   @default("")
  keepSecret       Boolean  @default(false)

  // Extras
  cardMessage      String   @default("")
  deliveryDate     String   @default("")
  deliverySlot     String   @default("")

  // Items stored as JSON string
  itemsJson        String   @default("[]")

  createdAt        DateTime @default(now())

  @@map("orders")
}

model Product {
  id            String   @id
  slug          String   @unique
  name          String
  tagline       String
  price         Float
  originalPrice Float
  category      String
  flowerType    String
  stemCount     Int
  rating        Float
  reviewCount   Int
  isBestseller  Boolean  @default(false)
  isNew         Boolean  @default(false)
  image         String
  symbolism     String
  description   String

  // JSON arrays stored as strings
  occasionJson  String   @default("[]")
  galleryJson   String   @default("[]")
  careTipsJson  String   @default("[]")
  sizesJson     String   @default("[]")

  createdAt     DateTime @default(now())

  @@map("products")
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  description     String
  discountPercent Int?
  flatDiscount    Float?
  freeShipping    Boolean  @default(false)
  isActive        Boolean  @default(true)

  @@map("coupons")
}