{
  "name": "flora-lux-flower-store",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/deploy_migrations.mjs && next build",
    "vercel-build": "prisma generate && node scripts/deploy_migrations.mjs && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "db:deploy": "node scripts/deploy_migrations.mjs",
    "db:deploy:prod": "TARGET_ENV=production node scripts/deploy_migrations.mjs",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap"
  },
  "prisma": {
    "seed": "node_modules/.bin/tsx prisma/seed.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@payloadcms/storage-s3": "^3.90.2",
    "@prisma/client": "^5.22.0",
    "canvas-confetti": "^1.9.3",
    "graphql": "^16.14.2",
    "lucide-react": "^0.453.0",
    "next": "^15.2.9",
    "payload": "^3.90.2",
    "prisma": "^5.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
